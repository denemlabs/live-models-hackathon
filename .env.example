# Server only. Never prefix these keys with VITE_.
# Values are read from .env.local first, then .env.
OPENAI_API_KEY=
REACTOR_API_KEY=
# Optional backup from a separate Reactor account with its own capacity.
REACTOR_API_KEY_BACKUP=
# Narration needs text-to-speech; story calls need the Agents platform.
ELEVENLABS_API_KEY=
OPENAI_STORY_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
REACTOR_MODEL=reactor/visko-orbis-stable
PORT=3000
# Optional local development: reuse Railway APIs and its single video registry.
# DEV_API_ORIGIN=https://live-models-hackathon-production.up.railway.app
# Optional shared access code for a hosted hackathon demo.
APP_ACCESS_CODE=

# On Railway, persist session cleanup handles on its mounted volume.
# VIDEO_SESSION_STORE=/data/video-session.json
# The storyteller's voice, shared by narration and story calls.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
# The story call agent is created automatically on first use; pin its id here
# to reuse one agent across restarts.
ELEVENLABS_AGENT_ID=
ELEVENLABS_LLM=gemini-2.5-flash
